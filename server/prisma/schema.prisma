datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  pending
  completed
  overdue
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  avatar              String?
  userTelegram        String          @unique
  didUserInteractWithBot Boolean      @default(false)
  timezone            String          @default("UTC")
  userTelegramChatId  BigInt?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tasks               Task[]
  taskStatistic       TaskStatistic?

  @@map("users")
}

model Task {
  id                String      @id @default(uuid())
  fullTaskText      String
  taskTitle         String
  status            TaskStatus  @default(pending)
  whenRemindToDo    DateTime?
  dueTo             DateTime?
  lastTimeNotified  DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  madeByUser        User        @relation(fields: [madeByUserId], references: [id])
  madeByUserId      String

  @@map("tasks")
}

model TaskStatistic {
  id                            String   @id @default(uuid())
  completedTasks                Int      @default(0)
  overduedTasks                 Int      @default(0)
  pendingTasks                  Int      @default(0)
  amountOfAllTasksEverMadeByUser Int     @default(0)
  referredToUser                User     @relation(fields: [referredToUserId], references: [id])
  referredToUserId              String   @unique
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("task_statistics")
}
